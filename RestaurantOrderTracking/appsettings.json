{
  "ConnectionStrings": {
    "DefaultConnection": "${ConnectionStrings__DefaultConnection}"
  },
  "JwtSettings": {
    "SecretKey": "${JwtSettings__SecretKey}",
    "Issuer": "${JwtSettings__Issuer}",
    "Audience": "${JwtSettings__Audience}",
    "ExpiryMinutes": "${JwtSettings__ExpiryMinutes}"
  },
  "RateLimitSettings": {
    "PermitLimit": "${RateLimitSettings__PermitLimit}",
    "Window": "${RateLimitSettings__WindowInSeconds}",
    "QueueLimit": "${RateLimitSettings__QueueLimit}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*"
}
